:80 {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto https
		}
	}
	handle /admin/* {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto https
		}
	}
	handle /health {
		reverse_proxy backend:8000 {
			header_up X-Forwarded-Proto https
		}
	}
	handle /static/* {
		reverse_proxy backend:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}