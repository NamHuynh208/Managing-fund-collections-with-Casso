# ============================================================
# MẪU CẤU HÌNH PRODUCTION — sao chép thành .env.prod rồi điền
# giá trị thật. KHÔNG đưa .env.prod lên Git.
# ============================================================

# --- Database ---
POSTGRES_DB=quy
POSTGRES_USER=quy_app
POSTGRES_PASSWORD=<mat_khau_postgres_ngau_nhien>
# Lưu ý: mật khẩu phải trùng trong dòng DATABASE_URL bên dưới
DATABASE_URL=postgres://quy_app:<mat_khau_postgres_ngau_nhien>@db:5432/quy

# --- Django ---
# Sinh khóa: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<chuoi_khoa_ngau_nhien_64_ky_tu>
DEBUG=False
ALLOWED_HOSTS=<ten_mien_cua_ban>,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://<ten_mien_cua_ban>
COOKIE_SECURE=True
FRONTEND_URL=https://<ten_mien_cua_ban>

# --- Web (Caddy) ---
# WEB_PORT=80                # đổi nếu cổng 80 bận
# SITE_ADDRESS=              # để trống nếu dùng Cloudflare Tunnel;
#                            # đặt tên miền (vd: quy.example.com) nếu muốn Caddy tự xin HTTPS
# X_FORWARDED_PROTO=https    # đặt http khi chạy thử prod nội bộ thuần HTTP

# --- Email (SMTP thật, ví dụ Resend/Brevo/Gmail app-password) ---
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=<mat_khau_smtp>
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=quy@<ten_mien_cua_ban>

# --- Ngân hàng quỹ (in trên QR chuyển khoản) ---
BANK_BIN=<ma_ngan_hang_va>       # vd 970436 (Vietcombank), tra cuu24h.vn
BANK_ACCOUNT_NO=<so_tai_khoan_nhan_quy>
BANK_ACCOUNT_NAME=<ten_chu_tai_khoan_in_hoa_khong_dau>
OPENING_BALANCE=0

# --- Webhook Casso (dashboard Casso -> Cài đặt -> Webhook) ---
CASSO_SECURE_KEY=<secure_key_tu_casso>

# --- Cloudflare Tunnel (tùy chọn) ---
# Zero-config tunnel: dashboard Cloudflare -> Zero Trust -> Networks -> Tunnels
# TUNNEL_TOKEN=<token_tunnel>

# --- Bank email / IMAP (tùy chọn, thay cho Casso) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
BANK_EMAIL_SENDER=

# --- Khác ---
MAGIC_LINK_TTL_MINUTES=15
GUNICORN_WORKERS=2
